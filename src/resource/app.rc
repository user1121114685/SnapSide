#include <winres.h>

#include "IconMover/Version.h"
#include "resource.h"

IDI_APP_ICON ICON "..\\..\\resources\\app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ICON_MOVER_FILE_VERSION
 PRODUCTVERSION ICON_MOVER_PRODUCT_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", ICON_MOVER_COMPANY_NAME
            VALUE "FileDescription", ICON_MOVER_FILE_DESCRIPTION
            VALUE "FileVersion", ICON_MOVER_VERSION_STRING
            VALUE "InternalName", ICON_MOVER_INTERNAL_NAME
            VALUE "LegalCopyright", ICON_MOVER_COPYRIGHT
            VALUE "OriginalFilename", ICON_MOVER_ORIGINAL_FILENAME
            VALUE "ProductName", ICON_MOVER_PRODUCT_NAME
            VALUE "ProductVersion", ICON_MOVER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
